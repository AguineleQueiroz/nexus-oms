{
  "name": "nexus/oms-api",
  "description": "Nexus Order Management System API",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "php-amqplib/php-amqplib": "^3.0",
    "vlucas/phpdotenv": "^5.0",
    "ext-pdo": "*",
    "ext-redis": "*"
  },
  "require-dev": {
    "pestphp/pest": "^2.0",
    "mockery/mockery": "^1.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "pest",
    "test:unit": "pest tests/Unit",
    "test:feature": "pest tests/Feature",
    "test:infra": "pest tests/Infrastructure"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "optimize-autoloader": true
  },
  "minimum-stability": "stable"
}
